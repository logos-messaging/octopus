# Octopus coordinator settings. Copy to /etc/octopus/coordinator.env (systemd) or
# deploy/coordinator.env (docker compose) and chmod 600. Never commit the real file.

# --- GitHub (token mode OR App mode) -------------------------------------------------
# `octopus github setup` writes the token-mode values for you.
OCTOPUS_WEBHOOK_SECRET=
# Set while rotating the secret, then remove (see docs/coordinator-ops.md).
#OCTOPUS_WEBHOOK_SECRET_PREVIOUS=
OCTOPUS_GITHUB_TOKEN=
#OCTOPUS_GITHUB_APP_ID=
# systemd: /etc/octopus/app-key.pem. docker compose: /run/secrets/app-key.
#OCTOPUS_GITHUB_APP_KEY_FILE=
#OCTOPUS_GITHUB_API_URL=https://HOST/api/v3

# --- What may run (at least one) -----------------------------------------------------
#OCTOPUS_GITHUB_REPO=acme/app
#OCTOPUS_ALLOWED_REPOS=acme/app,acme/other
#OCTOPUS_ALLOWED_ORGS=acme

# --- Network -------------------------------------------------------------------------
# The address runners reach this node at.
OCTOPUS_PUBLIC_IP=
OCTOPUS_TCP_PORT=60000
# Other coordinators' multiaddrs, comma separated.
#OCTOPUS_ENTRY_NODES=

# --- Operations ----------------------------------------------------------------------
# Public webhook URL, shown on start.
#OCTOPUS_WEBHOOK_URL=https://octopus.example.org/github/webhook
# Where the webhook HTTP listener binds; put the TLS proxy in front of it.
#OCTOPUS_WEBHOOK_LISTEN=127.0.0.1:8080
# /healthz, /readyz and /metrics. Keep it on a private interface, or `off` to disable.
#OCTOPUS_METRICS_LISTEN=127.0.0.1:9100
# Public domain for the compose Caddy proxy.
#OCTOPUS_DOMAIN=octopus.example.org
